@model TaskBoard.Web.Models.CreateTaskViewModel

@{
    ViewData["Title"] = "Yeni Görev Ekle";
}

<div class="card" style="max-width: 600px; margin: 30px auto;">
    <h2>Yeni Görev Ekle</h2>

    
    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 15px; font-weight: 600;"></div>

    <form asp-controller="Tasks" asp-action="Create" method="post">
       
        <div class="form-group">
            <label asp-for="Title">Görev Başlığı</label>
            <input asp-for="Title" class="form-control" placeholder="Örn: Server-side validation ekle" />
            <span asp-validation-for="Title" class="text-danger" style="font-size: 0.82rem; color: #dc2626;"></span>
        </div>

       
        <div class="form-group">
            <label asp-for="Priority">Öncelik Seviyesi</label>
            <select asp-for="Priority" class="form-control">
                <option value="low">Düşük</option>
                <option value="normal">Normal</option>
                <option value="high">Yüksek</option>
            </select>
            <span asp-validation-for="Priority" class="text-danger" style="font-size: 0.82rem; color: #dc2626;"></span>
        </div>

        
        <div class="form-group">
            <label asp-for="Description">Açıklama</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Göreve dair detaylı notlar (maksimum 500 karakter)..."></textarea>
            <span asp-validation-for="Description" class="text-danger" style="font-size: 0.82rem; color: #dc2626;"></span>
        </div>

        <div style="display: flex; gap: 10px; margin-top: 20px;">
            <button type="submit" class="btn">Görevi Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary" style="text-decoration: none; display: inline-flex; align-items: center; justify-content: center;">İptal</a>
        </div>
    </form>
</div>